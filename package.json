{
  "name": "fiapauto",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "backend",
    "backend/bots",
    "packages/contracts",
    "packages/server-core",
    "services/public-api",
    "services/admin-api",
    "apps/web-public",
    "apps/web-admin"
  ],
  "scripts": {
    "dev": "node utilities/scripts/dev.mjs all",
    "dev:public": "node utilities/scripts/dev.mjs public",
    "dev:admin": "node utilities/scripts/dev.mjs admin",
    "dev:web": "npm run dev:web:public",
    "dev:web:public": "npm run dev -w @fiapauto/web-public",
    "dev:web:admin": "npm run dev -w @fiapauto/web-admin",
    "dev:api": "npm run dev:api:admin",
    "dev:api:public": "npm run dev -w @fiapauto/public-api",
    "dev:api:admin": "npm run dev -w @fiapauto/admin-api",
    "build": "npm run build -w @fiapauto/contracts && npm run build -w @fiapauto/server-core && npm run build -w @fiapauto/backend && npm run build -w @fiapauto/bots && npm run build -w @fiapauto/public-api && npm run build -w @fiapauto/admin-api && npm run build -w @fiapauto/web-public && npm run build -w @fiapauto/web-admin",
    "lint": "eslint frontend backend apps services packages",
    "preview": "npm run preview -w @fiapauto/web-public",
    "bot:test": "npm run test -w @fiapauto/bots",
    "bot:worker": "npm run worker -w @fiapauto/bots",
    "test:smoke": "node utilities/tests/run-smoke.mjs",
    "public:up": "powershell -ExecutionPolicy Bypass -File utilities/scripts/start-public-stack.ps1",
    "public:status": "powershell -ExecutionPolicy Bypass -File utilities/scripts/public-stack-status.ps1",
    "publish:prepare": "npm run publish:prepare -w @fiapauto/backend",
    "publish:push": "npm run publish:push -w @fiapauto/backend",
    "publish:pull": "npm run publish:pull -w @fiapauto/backend",
    "publish:status": "npm run publish:status -w @fiapauto/backend",
    "publish:embed": "node utilities/scripts/sync-public-bundle.mjs",
    "cloud:build:public-api": "node aws/scripts/build-public-api.mjs",
    "cloud:zip:public-api": "bestzip aws/dist/public-api.zip aws/dist/public-api/*",
    "cloud:prepare:public-api": "npm run cloud:build:public-api && npm run cloud:zip:public-api",
    "cloud:upload:public-api": "node aws/scripts/upload-public-api-artifact.mjs",
    "cloud:deploy:public-api": "node aws/scripts/deploy-public-api-stack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "bestzip": "^2.2.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
