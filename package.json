{
  "name": "fiapauto",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "backend/bots"
  ],
  "scripts": {
    "dev": "node utilities/scripts/dev.mjs",
    "dev:web": "npm run dev -w @fiapauto/frontend",
    "dev:api": "npm run dev -w @fiapauto/backend",
    "build": "npm run build -w @fiapauto/backend && npm run build -w @fiapauto/bots && npm run build -w @fiapauto/frontend",
    "lint": "eslint frontend backend",
    "preview": "npm run preview -w @fiapauto/frontend",
    "bot:test": "npm run test -w @fiapauto/bots",
    "bot:worker": "npm run worker -w @fiapauto/bots"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
